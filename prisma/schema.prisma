generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                    User[]
  projects                 Project[]
  workItems                WorkItem[]
  blockers                 Blocker[]
  risks                    Risk[]
  agreements               Agreement[]
  templates                Template[]
  templateCategories       TemplateCategory[]
  portfolioHealthSnapshots PortfolioHealthSnapshot[]
  projectHealthConfig      ProjectHealthConfig?
  taskDependencies         TaskDependency[]
  projectCalendars         ProjectCalendar[]
  gates                    Gate[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  email          String   @unique
  passwordHash   String   @map("password_hash")
  name           String
  roles          Json // Array of UserRole enums stored as JSON
  locale         String   @default("es")
  avatar         String?  @db.LongText
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization          Organization          @relation(fields: [organizationId], references: [id])
  ownedProjects         Project[]             @relation("ProjectOwner")
  managedProjects       Project[]             @relation("ProjectManager")
  projectCollaborations ProjectCollaborator[]
  ownedWorkItems        WorkItem[]            @relation("WorkItemOwner")
  ownedRisks            Risk[]                @relation("RiskOwner")
  createdAgreements     Agreement[]           @relation("AgreementCreator")
  createdAgreementNotes AgreementNote[]       @relation("AgreementNoteCreator")
  workItemChanges       WorkItemChange[]
  templateUsage         TemplateUsage[]
  viewPreferences       ViewPreference[]
  resource              Resource?

  @@index([organizationId])
  @@map("users")
}

model Project {
  id               String   @id @default(uuid()) @db.Char(36)
  organizationId   String   @map("organization_id") @db.Char(36)
  ownerId          String   @map("owner_id") @db.Char(36)
  projectManagerId String?  @map("project_manager_id") @db.Char(36)
  name             String
  description      String   @db.Text
  client           String
  startDate        DateTime @map("start_date") @db.Date
  estimatedEndDate DateTime @map("estimated_end_date") @db.Date
  status           String   @default("PLANNING")
  archived         Boolean  @default(false)
  plannedHours     Int?     @map("planned_hours")
  progressCutoffDate DateTime? @map("progress_cutoff_date") @db.Date
  actualHours      Int?     @map("actual_hours")

  // Cómo se acumula el avance de un resumen desde sus hijas (§2, §3.6).
  //
  // "DURACION" lo pondera por la duración de cada hija —responde «¿cuánto trabajo está hecho?»— y
  // "PROMEDIO" las cuenta por igual —«¿cuántas cosas están hechas?»—. El spec pide los dos con el
  // mismo ejemplo: un hijo de 4 días al 100 % y cuatro de 1 día al 0 % dan 50 % y 20 %.
  //
  // Ninguno es «el correcto»: son dos verdades sobre cosas distintas, y por eso es un ajuste del
  // proyecto y no una decisión del motor. Por omisión el ponderado, que es lo que la aplicación ha
  // calculado siempre.
  progressRollup   String   @default("DURACION") @map("progress_rollup") @db.VarChar(20)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization     Organization          @relation(fields: [organizationId], references: [id])
  owner            User                  @relation("ProjectOwner", fields: [ownerId], references: [id])
  projectManager   User?                 @relation("ProjectManager", fields: [projectManagerId], references: [id])
  collaborators    ProjectCollaborator[]
  viewPreferences  ViewPreference[]
  baselines        Baseline[]
  savedFilters     SavedFilter[]
  workItems        WorkItem[]
  blockers         Blocker[]
  risks            Risk[]
  agreements       Agreement[]
  kanbanColumns    KanbanColumn[]
  aiAnalysisCache  AIAnalysisCache?
  templateUsage    TemplateUsage[]
  taskDependencies TaskDependency[]
  calendar         ProjectCalendar?
  gates            Gate[]

  @@index([organizationId])
  @@index([organizationId, archived])
  @@index([ownerId])
  @@index([projectManagerId])
  @@map("projects")
}

model ProjectCollaborator {
  id        String   @id @default(uuid()) @db.Char(36)
  projectId String   @map("project_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  role      String   @default("COLLABORATOR") // "OWNER" or "COLLABORATOR"
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_collaborators")
}

model KanbanColumn {
  id         String @id @default(uuid()) @db.Char(36)
  projectId  String @map("project_id") @db.Char(36)
  name       String
  order      Int
  columnType String @map("column_type")

  /// Verdadero en la columna donde nace una línea nueva. El «Abierto» del §4.7.
  ///
  /// Estos dos indicadores son lo que el §5.5 pide al hablar de `TaskStatusOption`: sin ellos, una
  /// columna que alguien añada no significa nada para el sistema —el tablero rechazaba en silencio
  /// soltar tarjetas en ella— y el acoplamiento estado↔avance no tiene sobre qué decidir.
  ///
  /// No se añadió una tabla nueva porque las columnas de este tablero **ya son** una tabla por
  /// proyecto. Dos tablas para «qué estados tiene este proyecto» serían dos verdades.
  isInitial  Boolean @default(false) @map("is_initial")
  /// Verdadero en las columnas que significan que la línea ya no está en juego.
  isDone     Boolean @default(false) @map("is_done")

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItems WorkItem[]

  @@unique([projectId, order])
  @@index([projectId])
  @@map("kanban_columns")
}

model WorkItem {
  id               String    @id @default(uuid()) @db.Char(36)
  organizationId   String    @map("organization_id") @db.Char(36)
  projectId        String    @map("project_id") @db.Char(36)
  ownerId          String    @map("owner_id") @db.Char(36)
  title            String
  description      String    @db.Text
  phase            String?
  status           String
  priority         String
  startDate        DateTime  @map("start_date") @db.Date
  estimatedEndDate DateTime  @map("estimated_end_date") @db.Date
  completedAt      DateTime? @map("completed_at")
  estimatedHours   Int?      @map("estimated_hours")
  templateOrder    Int?      @map("template_order")

  // ── PLANEACIÓN · Responsabilidad del cliente (C6) ──────────────────────────
  // Clase de línea: "ACTIVIDAD", "HITO", "PUNTO_DE_CONTROL", "APROBACION_CLIENTE",
  // "ENTREGA_CLIENTE", "COMPUERTA", "RESUMEN".
  kind        String    @default("ACTIVIDAD") @db.VarChar(20)
  // Quién responde: "PROVEEDOR", "CLIENTE" o "AMBOS".
  party       String    @default("PROVEEDOR") @db.VarChar(10)
  // Nombre de quien responde del lado del cliente. Es un nombre, no una cuenta: quien entrega del
  // lado del cliente casi nunca tiene usuario en la herramienta del proveedor, y exigirle uno es la
  // forma más rápida de que esas líneas terminen asignadas a alguien que no las controla.
  clientOwner String?   @map("client_owner")
  recoverability String? @db.VarChar(20)
  responsibleName String? @map("responsible_name")
  // Fecha límite comprometida, cuando es distinta de la que calcula el plan.
  dueDate     DateTime? @map("due_date") @db.Date

  /// Restricción de fecha (§3.4). Nula significa «lo antes posible», que es lo normal.
  ///
  /// Sólo los dos tipos que el motor entiende hoy: `NO_ANTES_DE` (el `SNET` del spec) y
  /// `DEBE_EMPEZAR_EL` (`MSO`). Las otras seis del §3.4 no se guardan **a propósito**: guardar un
  /// tipo que el motor no aplica daría un plan que dice una cosa y se programa de otra, y eso es
  /// peor que no tenerlo.
  constraintType String?   @map("constraint_type") @db.VarChar(20)
  constraintDate DateTime? @map("constraint_date") @db.Date

  // ── PLANEACIÓN · Jerarquía y avance ponderado (C7) ─────────────────────────
  // Línea de la que cuelga esta. De aquí sale el prorrateo: un resumen no tiene avance propio,
  // hereda el de sus hijas pesado por el trabajo de cada una.
  parentId    String? @map("parent_id") @db.Char(36)
  // Avance de 0 a 1. En un resumen se calcula, no se captura.
  progressPct Float   @default(0) @map("progress_pct")

  // ── PLANEACIÓN · Trazabilidad por línea (C9) ───────────────────────────────
  // De dónde salió esta línea. Cuando un plan integra varias fuentes es lo único que permite
  // reconciliar después.
  //
  // OJO: estos campos LOS VE EL CLIENTE. Nada de nombres del equipo interno, versiones de trabajo
  // ni notas de edición — lib/scheduling/traceability.ts los revisa antes de guardar.
  sourceFile     String?  @map("source_file")
  // Versión del documento tal como el cliente la conoce, no la de trabajo.
  sourceVersion  String?  @map("source_version")
  sourceSheet    String?  @map("source_sheet")
  sourceRow      Int?     @map("source_row")
  // Identificador que la línea tenía en su origen.
  sourceId       String?  @map("source_id")
  // Nota de trazabilidad, redactada para el cliente.
  traceability   String?  @db.Text
  kanbanColumnId String   @map("kanban_column_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization        @relation(fields: [organizationId], references: [id])
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner         User                @relation("WorkItemOwner", fields: [ownerId], references: [id])
  kanbanColumn  KanbanColumn        @relation(fields: [kanbanColumnId], references: [id])
  blockers      Blocker[]
  changes       WorkItemChange[]
  agreements    AgreementWorkItem[]
  // Vínculos en los que esta tarea es la sucesora, es decir, los que la pueden retrasar.
  incomingLinks TaskDependency[]    @relation("DependencySuccessor")
  // Vínculos en los que esta tarea es la predecesora.
  outgoingLinks TaskDependency[]    @relation("DependencyPredecessor")
  // Compuertas que habilitan a esta tarea.
  assignments   Assignment[]
  baselineItems BaselineItem[]
  parent        WorkItem?           @relation("WorkItemHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children      WorkItem[]          @relation("WorkItemHierarchy")
  gateUnlocks   GateUnlock[]
  // Compuertas cuyo hito de cierre es esta línea.
  closesGates   Gate[]              @relation("GateClosingMilestone")

  @@index([organizationId, projectId])
  @@index([ownerId])
  @@index([status])
  @@index([phase])
  // Índice compuesto para filtrado eficiente por organización, estado y prioridad
  @@index([organizationId, status, priority])
  // Índice para consultas de items atrasados
  @@index([estimatedEndDate])
  // Para la vista de lo que el cliente debe entregar o decidir, ordenada por fecha.
  @@index([organizationId, party, dueDate])
  // Para recorrer la jerarquía de un plan sin barrer la tabla.
  @@index([parentId])
  @@map("work_items")
}

model WorkItemChange {
  id          String   @id @default(uuid()) @db.Char(36)
  workItemId  String   @map("work_item_id") @db.Char(36)
  changedById String   @map("changed_by_id") @db.Char(36)
  field       String
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  changedAt   DateTime @default(now()) @map("changed_at")

  workItem  WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  changedBy User     @relation(fields: [changedById], references: [id])

  @@index([workItemId])
  @@map("work_item_changes")
}

model Blocker {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  projectId      String    @map("project_id") @db.Char(36)
  workItemId     String    @map("work_item_id") @db.Char(36)
  description    String    @db.Text
  blockedBy      String    @map("blocked_by")
  severity       String
  startDate      DateTime  @map("start_date") @db.Date
  resolvedAt     DateTime? @map("resolved_at")
  resolution     String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItem     WorkItem     @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId])
  @@index([workItemId])
  @@index([severity])
  // Índice compuesto para filtrar blockers activos por organización
  @@index([organizationId, resolvedAt])
  @@map("blockers")
}

model Risk {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  projectId      String    @map("project_id") @db.Char(36)
  ownerId        String    @map("owner_id") @db.Char(36)
  description    String    @db.Text
  probability    Int
  impact         Int
  riskLevel      String    @map("risk_level")
  mitigationPlan String    @map("mitigation_plan") @db.Text
  status         String
  identifiedAt   DateTime  @map("identified_at") @db.Date
  closedAt       DateTime? @map("closed_at") @db.Date
  closureNotes   String?   @map("closure_notes") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner        User         @relation("RiskOwner", fields: [ownerId], references: [id])

  @@index([organizationId, projectId])
  @@index([ownerId])
  @@index([riskLevel])
  // Índice compuesto para filtrado de riesgos por organización, estado y nivel
  @@index([organizationId, status, riskLevel])
  @@map("risks")
}

model Agreement {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  projectId      String    @map("project_id") @db.Char(36)
  createdById    String    @map("created_by_id") @db.Char(36)
  title          String    @db.VarChar(255)
  description    String    @db.Text
  agreementDate  DateTime  @map("agreement_date") @db.Date
  participants   String    @db.Text
  status         String
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id])
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User                @relation("AgreementCreator", fields: [createdById], references: [id])
  workItems    AgreementWorkItem[]
  notes        AgreementNote[]

  @@index([organizationId, projectId])
  @@index([createdById])
  // Índice para filtrado por estado
  @@index([status])
  @@map("agreements")
}

model AgreementWorkItem {
  agreementId String @map("agreement_id") @db.Char(36)
  workItemId  String @map("work_item_id") @db.Char(36)

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  workItem  WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@id([agreementId, workItemId])
  @@index([workItemId])
  @@map("agreement_work_items")
}

model AgreementNote {
  id          String   @id @default(uuid()) @db.Char(36)
  agreementId String   @map("agreement_id") @db.Char(36)
  createdById String   @map("created_by_id") @db.Char(36)
  note        String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  createdBy User      @relation("AgreementNoteCreator", fields: [createdById], references: [id])

  @@index([agreementId])
  @@map("agreement_notes")
}

model AIAnalysisCache {
  id           String   @id @default(uuid()) @db.Char(36)
  projectId    String   @unique @map("project_id") @db.Char(36)
  analysisData Json     @map("analysis_data")
  analyzedAt   DateTime @map("analyzed_at")
  expiresAt    DateTime @map("expires_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Índice para limpieza de cache expirado
  @@index([expiresAt])
  @@map("ai_analysis_cache")
}

model Template {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  name           String   @db.VarChar(255)
  description    String   @db.Text
  categoryId     String?  @map("category_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id])
  category     TemplateCategory? @relation(fields: [categoryId], references: [id])
  phases       TemplatePhase[]
  usageRecords TemplateUsage[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([organizationId, categoryId])
  @@map("templates")
}

model TemplateCategory {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  name           String   @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  templates    Template[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("template_categories")
}

model TemplatePhase {
  id         String   @id @default(uuid()) @db.Char(36)
  templateId String   @map("template_id") @db.Char(36)
  name       String   @db.VarChar(255)
  order      Int
  createdAt  DateTime @default(now()) @map("created_at")

  template   Template           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  activities TemplateActivity[]

  @@unique([templateId, order])
  @@index([templateId])
  @@map("template_phases")
}

model TemplateActivity {
  id                String   @id @default(uuid()) @db.Char(36)
  phaseId           String   @map("phase_id") @db.Char(36)
  title             String   @db.VarChar(255)
  description       String   @db.Text
  priority          String // LOW, MEDIUM, HIGH, CRITICAL
  estimatedDuration Int      @map("estimated_duration") // in hours
  order             Int
  createdAt         DateTime @default(now()) @map("created_at")

  phase TemplatePhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@unique([phaseId, order])
  @@index([phaseId])
  @@map("template_activities")
}

model PortfolioHealthSnapshot {
  id               String   @id @default(uuid()) @db.Char(36)
  organizationId   String   @map("organization_id") @db.Char(36)
  date             DateTime @db.Date
  healthScore      Int      @map("health_score")
  onTrack          Int      @map("on_track")
  atRisk           Int      @map("at_risk")
  criticalBlockers Int      @map("critical_blockers")
  completionRate   Float    @map("completion_rate")
  inProgress       Int      @map("in_progress")
  completed        Int

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId, date])
  @@map("portfolio_health_snapshots")
}

model TemplateUsage {
  id         String   @id @default(uuid()) @db.Char(36)
  templateId String   @map("template_id") @db.Char(36)
  projectId  String   @map("project_id") @db.Char(36)
  userId     String   @map("user_id") @db.Char(36)
  appliedAt  DateTime @default(now()) @map("applied_at")

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([templateId])
  @@index([projectId])
  @@index([userId])
  @@map("template_usage")
}

// ─── Project Health Configuration ────────────────────────────────────────────
// Stores per-organization rules for classifying project health.
// Changing a value here propagates instantly to all dashboards and views.
model ProjectHealthConfig {
  id             String @id @default(uuid()) @db.Char(36)
  organizationId String @unique @map("organization_id") @db.Char(36)

  // ── BLOCKER rules ─────────────────────────────────────────────────────────
  // How many unresolved CRITICAL blockers trigger CRÍTICO category
  criticalBlockerMin Int @default(1) @map("critical_blocker_min")

  // ── RISK rules ────────────────────────────────────────────────────────────
  // How many open HIGH/CRITICAL risks trigger EN RIESGO category
  highRiskMin Int @default(1) @map("high_risk_min")

  // ── SCHEDULE PERFORMANCE INDEX (SPI) rules ────────────────────────────────
  // SPI = completionRate / timeElapsedPct
  // Only applied once >= spiMinElapsedPct of the project timeline has passed
  // (avoids penalizing brand-new projects with no tasks done yet)
  spiMinElapsedPct     Float @default(15.0) @map("spi_min_elapsed_pct")
  // SPI below this → CRÍTICO (project completion is critically behind schedule)
  criticalSpiThreshold Float @default(0.50) @map("critical_spi_threshold")
  // SPI below this → EN RIESGO
  atRiskSpiThreshold   Float @default(0.80) @map("at_risk_spi_threshold")

  // ── OVERDUE TASK rules ────────────────────────────────────────────────────
  // If (overdueTaskCount / totalTasks * 100) >= this → EN RIESGO
  // Using a percentage avoids penalizing large projects for 1–2 stale tasks
  overdueTaskPctThreshold Float @default(25.0) @map("overdue_task_pct_threshold")

  // ── A TIEMPO threshold ────────────────────────────────────────────────────
  // If not critical/at-risk: SPI >= this → A TIEMPO, else → SIN ALERTAS
  // (projects with no timeline data fall back to completionRate >= 70%)
  onTrackSpiMin Float @default(0.90) @map("on_track_spi_min")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("project_health_configs")
}

// ─────────────────────────────────────────────────────────────────────────────
// PLANEACIÓN · Vínculos entre tareas (C1)
//
// Una dependencia no es «A antes que B». Tiene un tipo, que dice qué extremo de la predecesora
// amarra qué extremo de la sucesora, y un desfase en días hábiles que puede ser negativo.
//
// El cálculo vive en lib/scheduling/, sobre estructuras en memoria. Esta tabla solo guarda el
// dato; el motor no consulta la base.
// ─────────────────────────────────────────────────────────────────────────────
model TaskDependency {
  id             String @id @default(uuid()) @db.Char(36)
  organizationId String @map("organization_id") @db.Char(36)
  projectId      String @map("project_id") @db.Char(36)
  predecessorId  String @map("predecessor_id") @db.Char(36)
  successorId    String @map("successor_id") @db.Char(36)

  // "FS" fin-comienzo · "SS" comienzo-comienzo · "FF" fin-fin · "SF" comienzo-fin
  linkType String @default("FS") @map("link_type") @db.VarChar(2)

  // Desfase en días hábiles, con signo. Positivo es una espera; negativo es un solapamiento
  // declarado a propósito y NO se recorta a cero.
  lagDays Int @default(0) @map("lag_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessor  WorkItem     @relation("DependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor    WorkItem     @relation("DependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  // Dos tareas se relacionan de una sola forma: con dos vínculos no se sabría cuál manda.
  @@unique([predecessorId, successorId])
  @@index([organizationId, projectId])
  @@index([projectId])
  @@index([successorId])
  @@map("task_dependencies")
}

// ─────────────────────────────────────────────────────────────────────────────
// PLANEACIÓN · Calendario laboral del proyecto (C3)
//
// Qué días se trabajan y qué días no. Los feriados del país NO se guardan aquí: se calculan a
// partir de las reglas de lib/scheduling/holidays.ts, porque una tabla escrita a mano envejece en
// cuanto el plan cruza a diciembre. Aquí solo va lo que no se puede deducir: qué país aplica, qué
// días de la semana se trabajan y qué días para este proyecto en particular.
// ─────────────────────────────────────────────────────────────────────────────
model ProjectCalendar {
  id             String @id @default(uuid()) @db.Char(36)
  organizationId String @map("organization_id") @db.Char(36)
  projectId      String @unique @map("project_id") @db.Char(36)

  // Días de la semana que se trabajan, como arreglo: 0 domingo, 1 lunes, … 6 sábado.
  workingWeekdays Json @default("[1, 2, 3, 4, 5]") @map("working_weekdays")

  // País del que se toman los feriados: "CO", "MX". Nulo significa que solo se respeta el fin de
  // semana y los días propios del proyecto.
  holidayCountry String? @map("holiday_country") @db.VarChar(2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  holidays     ProjectHoliday[]

  @@index([organizationId])
  @@map("project_calendars")
}

// Días no laborables propios del proyecto, además de los del país: un corte pactado, un cierre de
// oficinas, un día de inventario.
model ProjectHoliday {
  id         String   @id @default(uuid()) @db.Char(36)
  calendarId String   @map("calendar_id") @db.Char(36)
  date       DateTime @db.Date
  // Nombre como lo lee el cliente. Nada de notas internas: esto aparece en el plan que él revisa.
  name       String
  createdAt  DateTime @default(now()) @map("created_at")

  calendar ProjectCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, date])
  @@index([calendarId])
  @@map("project_holidays")
}

// ─────────────────────────────────────────────────────────────────────────────
// PLANEACIÓN · Compuertas (C5)
//
// Una compuerta no es una tarea ni un hito: es un conjunto de condiciones que, al cumplirse todas,
// habilita a un grupo de tareas a empezar. El plan alterno es obligatorio a propósito — una
// compuerta sin plan alterno no es una compuerta, es una esperanza.
// ─────────────────────────────────────────────────────────────────────────────
model Gate {
  id             String @id @default(uuid()) @db.Char(36)
  organizationId String @map("organization_id") @db.Char(36)
  projectId      String @map("project_id") @db.Char(36)
  name           String

  // Qué se hace si la compuerta no cierra. Obligatorio y visible para el cliente.
  fallbackPlan String @map("fallback_plan") @db.Text

  // Línea que el plan registra cuando la compuerta cierra.
  closingMilestoneId String? @map("closing_milestone_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization     Organization    @relation(fields: [organizationId], references: [id])
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  closingMilestone WorkItem?       @relation("GateClosingMilestone", fields: [closingMilestoneId], references: [id])
  conditions       GateCondition[]
  unlocks          GateUnlock[]

  @@index([organizationId, projectId])
  @@index([projectId])
  @@map("gates")
}

// Una condición de la compuerta: qué falta, de quién es y para cuándo.
model GateCondition {
  id     String @id @default(uuid()) @db.Char(36)
  gateId String @map("gate_id") @db.Char(36)

  // Escrita para que un tercero pueda verificarla sin preguntarle a nadie.
  description String @db.Text
  // Nombre de quien responde. Sin dueño no hay a quién preguntarle.
  owner       String
  // "PROVEEDOR", "CLIENTE" o "AMBOS".
  party       String @default("CLIENTE") @db.VarChar(10)

  dueDate DateTime  @map("due_date") @db.Date
  // Fecha en que se cumplió. Nulo mientras siga pendiente.
  metOn   DateTime? @map("met_on") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  gate Gate @relation(fields: [gateId], references: [id], onDelete: Cascade)

  @@index([gateId])
  @@index([dueDate])
  @@map("gate_conditions")
}

// Qué tareas habilita la compuerta.
model GateUnlock {
  id         String @id @default(uuid()) @db.Char(36)
  gateId     String @map("gate_id") @db.Char(36)
  workItemId String @map("work_item_id") @db.Char(36)

  gate     Gate     @relation(fields: [gateId], references: [id], onDelete: Cascade)
  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([gateId, workItemId])
  @@index([workItemId])
  @@map("gate_unlocks")
}


/// Cómo tiene configurada cada persona cada vista de cada proyecto (§10.4).
///
/// Por usuario × proyecto × vista, no por usuario a secas: quien lleva ocho proyectos no quiere las
/// mismas columnas ni los mismos widgets en el que está arrancando que en el que está cerrando.
///
/// `settings` es JSON a propósito. Es preferencia de pantalla, no dato del negocio: nadie va a
/// consultarla ni a reportar sobre ella, y una columna por interruptor obligaría a una migración
/// cada vez que una vista gane un botón. Lo que sí se valida —en el servidor, con zod— es la forma
/// de lo que entra, para que un JSON con basura no llegue nunca a la tabla.
model ViewPreference {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  projectId      String   @map("project_id") @db.Char(36)
  // Qué vista: PANEL, GANTT, TABLERO, LISTA, CALENDARIO o CARGA.
  view           String   @db.VarChar(20)
  settings       Json
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Una fila por persona, proyecto y vista: el guardado es un upsert sobre esta clave.
  @@unique([userId, projectId, view])
  @@index([organizationId, projectId])
  @@map("view_preferences")
}


/// Quién —o qué— puede tener trabajo asignado (§8.2).
///
/// No es lo mismo que un usuario, y por eso es una tabla aparte. Un plan real reparte trabajo entre
/// gente con cuenta, gente del cliente que nunca la va a tener, proveedores y a veces máquinas o
/// ventanas de mantenimiento. Colgar la carga de `User` obligaría a inventar cuentas falsas para
/// que el cliente aparezca en la vista, que es la forma más rápida de acabar con un directorio
/// lleno de usuarios que nadie puede usar.
///
/// `userId` es opcional justo por eso: lleno para la gente del equipo, vacío para todo lo demás.
model Resource {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  name           String
  // PERSONA, EQUIPO, PROVEEDOR, MAQUINA o CLIENTE.
  kind           String   @default("PERSONA") @db.VarChar(20)
  userId         String?  @unique @map("user_id") @db.Char(36)
  // Minutos que da en un día laborable suyo. Ocho horas por omisión.
  dailyMinutes   Int      @default(480) @map("daily_minutes")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignments Assignment[]
  absences    ResourceAbsence[]

  @@index([organizationId])
  @@map("resources")
}

/// Quién trabaja en qué, y cuánto de su jornada le dedica (§8.2).
///
/// Es la tabla que el §8.2 declara **requisito previo** de la vista de carga: mientras una línea
/// tenga un solo responsable no hay forma de que la carga sea correcta, porque el reparto real de
/// un plan no es uno a uno.
///
/// Convive con `WorkItem.ownerId` en vez de sustituirlo. Ese campo sigue significando lo que
/// siempre significó —quién responde de la línea— y ninguna pantalla existente cambia. Lo que esta
/// tabla añade es otra cosa: quiénes le dedican tiempo y cuánto.
model Assignment {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  workItemId     String   @map("work_item_id") @db.Char(36)
  resourceId     String   @map("resource_id") @db.Char(36)
  /// Fracción de la jornada del recurso, en puntos base: 10000 es jornada completa.
  ///
  /// Enteros y no decimales por la misma razón que el dinero: tres asignaciones de un tercio tienen
  /// que sumar exactamente la jornada, y con flotantes «¿está sobrecargado?» acabaría dependiendo
  /// del error del último bit.
  unitsBp        Int      @default(10000) @map("units_bp")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  // Una persona no se asigna dos veces a la misma línea: se le sube el porcentaje.
  @@unique([workItemId, resourceId])
  @@index([resourceId])
  @@index([organizationId, workItemId])
  @@map("assignments")
}

/// Los días que un recurso no está: vacaciones, incapacidad, festivo propio (§8.1).
///
/// Su efecto es poner la capacidad de esos días a cero, con lo que cualquier trabajo que siga
/// planificado ahí sale marcado como sobrecarga — que es justo lo que hay que ver.
model ResourceAbsence {
  id         String   @id @default(uuid()) @db.Char(36)
  resourceId String   @map("resource_id") @db.Char(36)
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime @map("end_date") @db.Date
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId, startDate])
  @@map("resource_absences")
}


/// Una foto del plan en un momento dado (§3, §4.6).
///
/// El spec la pide como *snapshot directo* y no como historial completo, y es la decisión correcta:
/// la pregunta que una línea base responde —«¿cuánto nos hemos movido de lo que prometimos?»— sólo
/// necesita el estado de aquel día, no la secuencia de cambios que llevó hasta aquí. Un sistema de
/// eventos daría lo mismo y costaría veinte veces más.
///
/// Se guardan las fechas de **todas** las líneas, no sólo las que después cambien. En el momento de
/// tomarla no se sabe cuáles van a moverse, y una foto parcial no es una foto.
model Baseline {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  projectId      String   @map("project_id") @db.Char(36)
  name           String
  createdById    String   @map("created_by_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at")

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   BaselineItem[]

  @@index([projectId, createdAt])
  @@map("baselines")
}

/// El estado de una línea en el momento de la foto.
///
/// `budget` no está: el spec lo incluye, pero este modelo todavía no lleva dinero por línea, y una
/// columna siempre en cero mentiría al compararla. Entra el día que entre el presupuesto.
model BaselineItem {
  id         String   @id @default(uuid()) @db.Char(36)
  baselineId String   @map("baseline_id") @db.Char(36)
  workItemId String   @map("work_item_id") @db.Char(36)
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime @map("end_date") @db.Date
  /// Duración en días hábiles al tomar la foto, contando los dos extremos.
  ///
  /// Se guarda además de las fechas porque el calendario laborable puede cambiar —un festivo nuevo,
  /// un cambio de jornada— y entonces recalcularla desde las fechas daría un número que nunca fue
  /// verdad. La foto guarda lo que se prometió, no lo que hoy se deduciría.
  durationDays   Int  @map("duration_days")
  estimatedHours Int? @map("estimated_hours")
  /// Avance en puntos base: 10000 es el cien por cien.
  progressBp     Int  @map("progress_bp")

  baseline Baseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([baselineId, workItemId])
  @@index([workItemId])
  @@map("baseline_items")
}


/// Un filtro guardado con nombre (§10.2).
///
/// `expression` es JSON porque el filtro es un árbol de grupos AND/OR anidados, y una tabla
/// relacional para eso sería tres tablas y una consulta recursiva para leer lo que en el navegador
/// es un objeto. Lo que no se relaja es la forma: `lib/projects/filter.ts` la valida al guardar y
/// al leer, y un filtro que nombre un campo inexistente se rechaza en vez de aplicarse a medias.
///
/// `isShared` decide si lo ve todo el proyecto o sólo quien lo creó. Sin ese interruptor, o los
/// filtros personales ensucian la lista de todos, o no hay forma de acordar «miremos la vista de
/// bloqueadas» sin que cada cual la reconstruya.
model SavedFilter {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  projectId      String   @map("project_id") @db.Char(36)
  createdById    String   @map("created_by_id") @db.Char(36)
  name           String
  expression     Json
  isShared       Boolean  @default(false) @map("is_shared")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, isShared])
  @@index([createdById])
  @@map("saved_filters")
}
